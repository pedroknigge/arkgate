{
  "$schema": "https://unpkg.com/arkgate@4/schemas/ark.config.schema.json",
  "schemaVersion": "1.3",
  "name": "atlasgrid",
  "include": [
    "src"
  ],
  "layers": [
    {
      "name": "Presentation",
      "description": "Screens for one universe feature.",
      "patterns": [
        "src/components/**"
      ]
    },
    {
      "name": "Application",
      "description": "Use cases, universe-common domain, and shared helpers.",
      "patterns": [
        "src/lib/features/**",
        "src/lib/shared/**",
        "src/lib/compliance/**"
      ]
    },
    {
      "name": "Persistence",
      "description": "Repositories for one universe feature.",
      "patterns": [
        "src/lib/repositories/**"
      ]
    }
  ],
  "rules": [
    {
      "from": "Presentation",
      "to": "Presentation",
      "allowed": false,
      "peerIsolation": true,
      "sliceFolders": [
        "features"
      ],
      "sharedRoots": [
        "components/ui",
        "lib/shared"
      ],
      "childSlices": {
        "sliceFolders": [
          "lib/features/*/*",
          "components/features/*/*",
          "lib/repositories/features/*/*"
        ],
        "sliceIdentity": "stars",
        "commonFolders": [
          "domain"
        ],
        "siblings": "deny",
        "parentMayImportChild": false,
        "allowedCrossSlice": [
          {
            "from": "features/projects/*",
            "to": "features/projects/d2d-item"
          },
          {
            "from": "features/*/*",
            "to": "features/management/eos"
          }
        ]
      },
      "allowedCrossSlice": [
        {
          "from": "features/*",
          "to": "features/*"
        }
      ]
    },
    {
      "from": "Presentation",
      "to": "Application",
      "allowed": false,
      "peerIsolation": true,
