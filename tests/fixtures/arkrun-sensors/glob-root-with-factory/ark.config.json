{
  "schemaVersion": "1.2",
  "include": ["src"],
  "layers": [
    { "name": "DomainModel", "patterns": ["src/domain/**"] },
    { "name": "ApplicationOrchestration", "patterns": ["src/application/**", "src/nestjs/**"] }
  ],
  "rules": [{ "from": "ApplicationOrchestration", "to": "DomainModel", "allowed": true }],
  "arkRun": {
    "mode": "enforced",
    "compositionRoots": ["src/nestjs/**"],
    "managedLayers": ["ApplicationOrchestration", "DomainModel"]
  }
}
