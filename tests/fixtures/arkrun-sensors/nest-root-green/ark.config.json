{
  "schemaVersion": "1.2",
  "include": ["src"],
  "layers": [
    { "name": "DomainModel", "patterns": ["src/domain/**"] },
    {
      "name": "ApplicationOrchestration",
      "patterns": ["src/application/**", "src/app.module.ts", "src/async.module.ts", "src/lenient.ts"]
    }
  ],
  "rules": [{ "from": "ApplicationOrchestration", "to": "DomainModel", "allowed": true }],
  "arkRun": {
    "mode": "enforced",
    "compositionRoots": ["src/app.module.ts", "src/async.module.ts", "src/lenient.ts"],
    "managedLayers": ["ApplicationOrchestration", "DomainModel"],
    "requireDeclarations": true
  }
}
