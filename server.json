{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.pedroknigge/arkgate",
  "description": "When your agent writes TypeScript, ArkGate stops it from breaking the layers — and CI rejects the merge if it still does.",
  "repository": {
    "url": "https://github.com/pedroknigge/arkgate",
    "source": "github"
  },
  "version": "4.6.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "arkgate",
      "version": "4.6.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "arkgate-mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "value": ".",
          "description": "Project root"
        },
        {
          "type": "named",
          "name": "--config",
          "value": "ark.config.json",
          "description": "Path to the ArkGate architecture config"
        }
      ]
    }
  ]
}
