{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node bin/ark-mcp.mjs --session-context --root . --root-env CLAUDE_PROJECT_DIR --config ark.config.json"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node bin/ark-mcp.mjs --hook --hook-repair --root . --root-env CLAUDE_PROJECT_DIR --config ark.config.json"
          }
        ]
      }
    ]
  }
}
